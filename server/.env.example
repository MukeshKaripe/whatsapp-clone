# WhatsApp Clone Server - Environment Variables

# Server Configuration
PORT=5000
NODE_ENV=production

# Allowed Frontend Origins (supports single URL or comma-separated URLs)
# In production, set to your deployed Vercel or Netlify URL:
CLIENT_URL=https://your-app.vercel.app,https://your-app.netlify.app

# Database Configuration (Neon PostgreSQL, Supabase, Railway, or local Postgres)
# Replace with your actual Neon PostgreSQL connection string:
DATABASE_URL="postgresql://user:password@ep-something.neon.tech/neondb?sslmode=require"

# Authentication & Security
# Generate a secure 32+ character string in production
JWT_SECRET="whatsapp-clone-secret-key-change-in-production-2026"
JWT_EXPIRES_IN="7d"
