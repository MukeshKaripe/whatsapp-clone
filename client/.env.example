# WhatsApp Clone Client - Environment Variables

# Backend API URL:
# In local development, you can leave this unset.
# The client automatically connects to http://<your-hostname>:5000/api
#
# In production (Vercel / Netlify), set this to your deployed Render service URL:
VITE_API_URL=https://your-backend-service.onrender.com

# Optional: Dedicated Socket.IO Server URL
# If omitted, SocketContext automatically derives the socket endpoint from VITE_API_URL
# VITE_SOCKET_URL=https://your-backend-service.onrender.com
